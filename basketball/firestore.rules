rules_version = '2';

// Kansas Media Stats Basketball — Firestore rules for the basketball's own Firebase project.
// Paste the whole file into Firebase console → Firestore Database → Rules, then Publish.
//
// The tracker (bball stats/index.html) keeps every game as one document in `hoops`, holding the
// whole game as text, and each scorer's saved teams as `teams-<uid>`. Anyone signed in with Google
// can keep games, and only the owner can change their own. A game the owner has shared
// (public == true) can be read by anyone with its link and by the scoreboards, but never changed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownGame() {
      return signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }

    match /hoops/{gameId} {
      allow read: if (signedIn() && resource.data.owner == request.auth.uid)
                  || resource.data.public == true;
      allow create: if ownGame();
      allow update: if ownGame() && resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Anything not matched above is denied by default.
  }
}
