rules_version = '2';

// Press Box — Firestore security rules for the stats Firebase project
// (fb-stats-dc058). Paste into Firebase console → Firestore Database →
// Rules, then Publish. The Pick 'ems pool (ks-picks) has its own rules in
// the PICKS folder; nothing here touches it.
//
// index.html keeps each game as one document holding the whole game as
// text. Anyone signed in with Google can keep games, and only the owner
// can change their own. A game the owner has shared (public == true) can be
// read by anyone with its link — that is the live look-in — but never changed.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The site's admin (added 2026-09-15) can read every game, shared or not, for the admin-only
    // All Games list, and since 2026-09-16 can also correct one: update it in place, leaving the
    // owner as it was. Creating and deleting another scorer's game stays with that scorer.
    function isAdmin() {
      return signedIn() && request.auth.uid == '2lbD7tPuufPdkBPtxbgSYnZwizp2';
    }

    match /pressbox/{gameId} {
      allow read: if (signedIn() && resource.data.owner == request.auth.uid)
                  || resource.data.public == true
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.json is string
                    && request.resource.data.json.size() < 900000;

      allow update: if (signedIn()
                     && resource.data.owner == request.auth.uid
                     && request.resource.data.owner == request.auth.uid
                     && request.resource.data.json is string
                     && request.resource.data.json.size() < 900000)
                    || (isAdmin()
                     && request.resource.data.owner == resource.data.owner
                     && request.resource.data.json is string
                     && request.resource.data.json.size() < 900000);

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // A school's roster, shared (2026-09-26). A roster belongs to the school, not to the scorer who
    // typed it, so anyone signed in can add to one and anyone at all can read it — that is what lets a
    // second crew's game show names instead of bare numbers. The document is only a roster: no owner,
    // nothing private. Removing one stays with the admin.
    match /rosters/{school} {
      allow read: if true;
      allow create, update: if signedIn()
                    && request.resource.data.json is string
                    && request.resource.data.json.size() < 100000;
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
